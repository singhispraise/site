  <style>
    :root,[data-theme="light"]{
      --text-xs:clamp(.75rem,.7rem + .25vw,.875rem);
      --text-sm:clamp(.875rem,.8rem + .35vw,1rem);
      --text-base:clamp(1rem,.95rem + .25vw,1.125rem);
      --text-lg:clamp(1.125rem,1rem + .75vw,1.5rem);
      --text-xl:clamp(1.5rem,1.2rem + 1.25vw,2.25rem);
      --text-2xl:clamp(2rem,1.2rem + 2.5vw,3.5rem);
      --text-3xl:clamp(2.5rem,1rem + 4vw,5rem);
      --space-1:.25rem;--space-2:.5rem;--space-3:.75rem;--space-4:1rem;--space-5:1.25rem;--space-6:1.5rem;--space-8:2rem;--space-10:2.5rem;--space-12:3rem;--space-16:4rem;--space-20:5rem;--space-24:6rem;--space-32:8rem;
      --color-bg:#f6f1ea;--color-surface:#fbf8f3;--color-surface-2:#f2eadf;--color-surface-offset:#e7dccd;--color-border:#d9cab5;--color-divider:#e3d7c6;
      --color-text:#1f1a15;--color-text-muted:#665a4e;--color-text-faint:#948679;--color-text-inverse:#fbf8f4;
      --color-primary:#5b3928;--color-primary-hover:#45291c;--color-primary-highlight:#ead9cc;--color-secondary:#7f6c44;
      --shadow-sm:0 1px 2px rgba(29,20,14,.08);--shadow-md:0 12px 32px rgba(29,20,14,.10);--shadow-lg:0 28px 64px rgba(29,20,14,.14);
      --radius-sm:.375rem;--radius-md:.75rem;--radius-lg:1.25rem;--radius-xl:2rem;--radius-full:9999px;
      --content-narrow:720px;--content-default:1120px;--content-wide:1280px;
      --font-display:'Instrument Serif',Georgia,serif;--font-body:'Work Sans','Helvetica Neue',Arial,sans-serif;
      --transition-interactive:180ms cubic-bezier(.16,1,.3,1);
    }
    [data-theme="dark"]{
      --color-bg:#14110f;--color-surface:#1d1814;--color-surface-2:#271f1a;--color-surface-offset:#312821;--color-border:#4b3e33;--color-divider:#372d27;
      --color-text:#efe5d8;--color-text-muted:#cab9a4;--color-text-faint:#8e7d6d;--color-text-inverse:#1b1511;
      --color-primary:#d2b08e;--color-primary-hover:#e5c8ab;--color-primary-highlight:#49372d;--color-secondary:#bda16c;
      --shadow-sm:0 1px 2px rgba(0,0,0,.25);--shadow-md:0 12px 32px rgba(0,0,0,.32);--shadow-lg:0 30px 72px rgba(0,0,0,.4);
    }
    *,:before,:after{box-sizing:border-box;margin:0;padding:0}
    html{-webkit-font-smoothing:antialiased;text-size-adjust:none;scroll-behavior:smooth;scroll-padding-top:5rem}
    body{min-height:100dvh;font-family:var(--font-body);font-size:var(--text-base);line-height:1.65;background:var(--color-bg);color:var(--color-text)}
    img,svg{display:block;max-width:100%;height:auto}
    a,button,input,select{transition:color var(--transition-interactive),background var(--transition-interactive),border-color var(--transition-interactive),box-shadow var(--transition-interactive)}
    a{text-decoration:none;color:inherit} button{border:none;background:none;cursor:pointer}
    input,select,textarea{font:inherit;color:inherit}
    :focus-visible{outline:2px solid var(--color-primary);outline-offset:3px;border-radius:var(--radius-sm)}
    .skip-link{position:absolute;left:-9999px}.skip-link:focus{left:1rem;top:1rem;z-index:999;background:var(--color-surface);padding:.8rem 1rem;border-radius:var(--radius-md)}
    .container{width:min(calc(100% - 2rem),var(--content-default));margin-inline:auto}
    .wide{width:min(calc(100% - 2rem),var(--content-wide));margin-inline:auto}
    .eyebrow{font-size:var(--text-xs);letter-spacing:.16em;text-transform:uppercase;color:var(--color-text-muted)}
    h1,h2,h3,h4{font-family:var(--font-display);font-weight:400;line-height:1.03;text-wrap:balance}
    p,li{max-width:72ch;text-wrap:pretty}
    .site-header{position:sticky;top:0;z-index:70;background:color-mix(in srgb,var(--color-bg) 86%, transparent);backdrop-filter:blur(16px);border-bottom:1px solid color-mix(in srgb,var(--color-text) 8%, transparent)}
    .header-inner{display:flex;align-items:center;justify-content:space-between;gap:var(--space-4);padding:var(--space-4) 0}
    .brand{display:flex;align-items:center;gap:var(--space-3);font-size:var(--text-sm);font-weight:600;letter-spacing:.02em}
    .brand-mark{width:44px;height:44px;padding:8px;border-radius:50%;background:var(--color-primary-highlight);color:var(--color-primary)}
    .header-shell{display:flex;align-items:center;gap:var(--space-4)}
    nav ul{list-style:none;display:flex;gap:var(--space-4);flex-wrap:wrap}
    nav a{font-size:var(--text-sm);color:var(--color-text-muted)}
    nav a:hover,nav a:focus-visible{color:var(--color-text)}
    .header-actions{display:flex;align-items:center;gap:var(--space-3)}
    .theme-toggle,.menu-toggle{width:44px;height:44px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;border:1px solid color-mix(in srgb,var(--color-text) 12%, transparent);background:var(--color-surface)}
    .menu-toggle{display:none}
    .btn{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 var(--space-5);border-radius:var(--radius-full);font-size:var(--text-sm);font-weight:600}
    .btn-primary{background:var(--color-primary);color:var(--color-text-inverse)}
    .btn-primary:hover{background:var(--color-primary-hover)}
    .btn-secondary{border:1px solid color-mix(in srgb,var(--color-text) 12%, transparent);background:transparent;color:var(--color-text)}
    .btn-ghost{color:var(--color-text-muted)}
    .hero{padding:clamp(var(--space-12),10vw,var(--space-24)) 0 var(--space-20)}
    .hero-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:var(--space-10);align-items:end}
    h1{font-size:var(--text-3xl);max-width:10.5ch}
    .hero-copy p{margin-top:var(--space-5);color:var(--color-text-muted)}
    .cta-row{display:flex;gap:var(--space-3);flex-wrap:wrap;margin-top:var(--space-6)}
    .hero-composition{display:grid;gap:var(--space-4)}
    .hero-panel{background:linear-gradient(180deg,var(--color-surface),var(--color-surface-2));border:1px solid color-mix(in srgb,var(--color-text) 9%, transparent);border-radius:var(--radius-xl);padding:var(--space-8);box-shadow:var(--shadow-lg)}
    .hero-panel h2{font-size:var(--text-xl);margin-top:var(--space-3)}
    .stats-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-3);margin-top:var(--space-6)}
    .stat{padding:var(--space-4);background:var(--color-bg);border-radius:var(--radius-lg);border:1px solid color-mix(in srgb,var(--color-text) 8%, transparent)}
    .stat strong{display:block;font-size:var(--text-lg);font-family:var(--font-display);font-weight:400}
    main section{padding:clamp(var(--space-12),8vw,var(--space-24)) 0;border-top:1px solid color-mix(in srgb,var(--color-text) 8%, transparent)}
    .section-head{display:grid;grid-template-columns:.78fr 1.22fr;gap:var(--space-8);align-items:start;margin-bottom:var(--space-8)}
    .section-head h2{font-size:var(--text-2xl)}
    .section-head p{color:var(--color-text-muted)}
    .pillars,.site-map,.resource-grid,.leaders-grid,.path-grid,.event-grid{display:grid;gap:var(--space-5)}
    .pillars{grid-template-columns:repeat(4,minmax(0,1fr))}
    .site-map{grid-template-columns:repeat(3,minmax(0,1fr))}
    .resource-grid{grid-template-columns:1.05fr .95fr .95fr}
    .leaders-grid,.event-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
    .path-grid{grid-template-columns:repeat(4,minmax(0,1fr))}
    .card{background:var(--color-surface);border:1px solid color-mix(in srgb,var(--color-text) 10%, transparent);border-radius:var(--radius-lg);padding:var(--space-6);box-shadow:var(--shadow-sm)}
    .card h3{font-size:var(--text-lg);margin-bottom:var(--space-3)}
    .card h4{font-size:var(--text-xl);margin-bottom:var(--space-3)}
    .card p{color:var(--color-text-muted)}
    .card ul{list-style:none;display:grid;gap:var(--space-2);margin-top:var(--space-4);color:var(--color-text-muted);font-size:var(--text-sm)}
    .card li::before{content:'— ';color:var(--color-secondary)}
    .member-home{background:var(--color-surface-2);border-radius:calc(var(--radius-xl) + .5rem);padding:var(--space-6);border:1px solid color-mix(in srgb,var(--color-text) 9%, transparent);box-shadow:var(--shadow-md)}
    .member-grid{display:grid;grid-template-columns:280px 1fr;gap:var(--space-6)}
    .sidebar{background:var(--color-surface);border-radius:var(--radius-xl);padding:var(--space-5);border:1px solid color-mix(in srgb,var(--color-text) 8%, transparent)}
    .sidebar ul{list-style:none;display:grid;gap:var(--space-2);margin-top:var(--space-5)}
    .sidebar a{display:flex;align-items:center;justify-content:space-between;padding:.9rem 1rem;border-radius:var(--radius-md);color:var(--color-text-muted);background:transparent}
    .sidebar a.active,.sidebar a:hover{background:var(--color-primary-highlight);color:var(--color-primary)}
    .member-main{display:grid;gap:var(--space-5)}
    .dashboard-top{display:grid;grid-template-columns:1.2fr .8fr;gap:var(--space-5)}
    .module-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-5)}
    .chip{display:inline-flex;align-items:center;padding:.4rem .7rem;border-radius:999px;background:var(--color-primary-highlight);color:var(--color-primary);font-size:var(--text-xs);letter-spacing:.08em;text-transform:uppercase}
    .checklist{display:grid;gap:var(--space-3);margin-top:var(--space-4)}
    .check{display:flex;gap:var(--space-3);align-items:flex-start;padding-bottom:var(--space-3);border-bottom:1px solid color-mix(in srgb,var(--color-text) 8%, transparent)}
    .check strong{display:inline-flex;align-items:center;justify-content:center;flex:0 0 28px;height:28px;border-radius:50%;background:var(--color-primary-highlight);color:var(--color-primary);font-size:var(--text-xs)}
    .two-col{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-6)}
    .quote-block{background:var(--color-primary);color:var(--color-text-inverse);border-radius:var(--radius-xl);padding:var(--space-8)}
    .quote-block p{font-size:var(--text-lg);max-width:28ch}
    .calendar-item{padding:var(--space-4) 0;border-bottom:1px solid color-mix(in srgb,var(--color-text) 8%, transparent)}
    .calendar-item:last-child{border-bottom:none;padding-bottom:0}
    .calendar-item time{display:block;font-size:var(--text-xs);letter-spacing:.12em;text-transform:uppercase;color:var(--color-text-faint);margin-bottom:var(--space-2)}
    .footer-cta{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-8);align-items:start}
    form .field{display:grid;gap:.35rem}
    form input,form select,form textarea{width:100%;padding:.95rem 1rem;border-radius:var(--radius-md);border:1px solid color-mix(in srgb,var(--color-text) 12%, transparent);background:var(--color-surface-2)}
    textarea{min-height:120px;resize:vertical}
    footer{padding:var(--space-10) 0 var(--space-12)}
    .footer-bar{display:flex;justify-content:space-between;gap:var(--space-4);flex-wrap:wrap;padding-top:var(--space-6);border-top:1px solid color-mix(in srgb,var(--color-text) 8%, transparent);color:var(--color-text-muted)}
    @media (max-width:1024px){
      .hero-grid,.section-head,.dashboard-top,.footer-cta,.two-col,.pillars,.site-map,.resource-grid,.leaders-grid,.path-grid,.event-grid,.module-grid,.member-grid{grid-template-columns:1fr}
      .member-home{padding:var(--space-4)}
    }
    @media (max-width:900px){
      nav{display:none;position:absolute;left:1rem;right:1rem;top:calc(100% + .5rem);background:var(--color-surface);padding:var(--space-4);border-radius:var(--radius-lg);border:1px solid color-mix(in srgb,var(--color-text) 10%, transparent);box-shadow:var(--shadow-md)}
      nav.open{display:block}
      nav ul{flex-direction:column}
      .menu-toggle{display:inline-flex}
      .header-actions .desktop-only{display:none}
      h1{max-width:11.5ch}
      .stats-grid{grid-template-columns:1fr}
    }
    @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,:before,:after{transition:none!important}}
  </style>
</head>
<body>
